# ────────────────────────────────────────────────────────────────
# Marketo API Simulator - Environment Configuration Template
# Copy to .env and configure for your environment.
# ────────────────────────────────────────────────────────────────

# Application settings
APP_NAME=Marketo API Simulator
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database connection URL
# Local SQLite default:
DATABASE_URL=sqlite:///./marketo_simulator.db
# PostgreSQL example:
# DATABASE_URL=postgresql://marketo:marketo_pass@localhost:5432/marketo_simulator

# OAuth Client Credentials
MOCK_CLIENT_ID=marketo-poc-client
MOCK_CLIENT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=3599
TOKEN_HASH_SECRET=replace-with-a-long-random-value

# Export Timing & Lifecycle Simulation
QUEUE_DELAY_SECONDS=2
PROCESSING_DELAY_SECONDS=5

# Export Bounds & Queue Throttling
MAX_EXPORT_RANGE_DAYS=30
MAX_ACTIVE_EXPORT_JOBS=10
MIN_RECORDS_PER_DAY=1
MAX_RECORDS_PER_DAY=5
MAX_RECORDS_PER_EXPORT=10000
